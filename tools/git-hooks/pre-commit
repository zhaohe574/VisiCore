#!/bin/sh
# VisiCore（视枢）本地提交前凭据检查
#
# 安装：pwsh -File tools/install-git-hooks.ps1
# 该脚本把本文件复制为 .git/hooks/pre-commit（Git 钩子不进入版本控制）。
#
# 目的：在凭据进入 Git 历史之前拦截。历史一旦推送，清理成本远高于拦截。
#
# 实现说明：钩子以 /bin/sh 运行（Git for Windows 自带 sh），通过 pwsh 调用
# tools/git-hooks/pre-commit.ps1 完成实际检查，避免在 sh 中重写匹配逻辑。

root=$(git rev-parse --show-toplevel) || exit 0
script="$root/tools/git-hooks/pre-commit.ps1"
[ -f "$script" ] || exit 0

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$script"
  exit $?
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -File "$script"
  exit $?
else
  echo "警告：未找到 pwsh，跳过提交前凭据检查。" >&2
  exit 0
fi


$ErrorActionPreference = 'Stop'
$root = (& git rev-parse --show-toplevel 2>$null)
if (-not $root) { Write-Host '不在 Git 仓库中，跳过凭据检查。'; exit 0 }
Set-Location $root

# 1) 禁止提交未跟踪/被忽略的敏感文件。
$forbidden = @('HANDOFF.md', '.secrets/', '.p0-backup/')
$staged = & git diff --cached --name-only
foreach ($pattern in $forbidden) {
    $hit = $staged | Where-Object { $_ -like "$pattern*" }
    if ($hit) {
        Write-Host "拒绝提交：检测到受保护的敏感文件：$($hit -join ', ')" -ForegroundColor Red
        Write-Host '这些文件仅保存在内网工作区，不得进入版本控制。' -ForegroundColor Red
        exit 1
    }
}

# 2) 对暂存内容做模式匹配（不依赖 gitleaks 是否安装）。
$patterns = @(
    'os\.environ\.get\(\s*["''][A-Z0-9_]+["'']\s*,\s*["''][^"'']{3,}["'']\s*\)',  # 口令默认值
    '密码\s*[:：]\s*[^\s`''"，。）]{4,}',                                       # 文档明文口令
    '(?i)(ssh_password|admin_password|ipc_password|nvr_password)\s*[=:]\s*["''][^"''$<{]'
)
$diff = & git diff --cached -U0
$violations = @()
foreach ($p in $patterns) {
    $m = $diff | Select-String -Pattern $p -AllMatches
    if ($m) { $violations += $m }
}
if ($violations) {
    Write-Host '拒绝提交：暂存内容疑似包含明文凭据：' -ForegroundColor Red
    $violations | Select-Object -First 10 | ForEach-Object { Write-Host "  $($_.Line.Trim())" -ForegroundColor Yellow }
    Write-Host '请改用环境变量或未跟踪的 .secrets/deploy-credentials.txt。' -ForegroundColor Red
    exit 1
}

# 3) 若安装了 gitleaks，则额外执行一次全量规则检查。
$gitleaks = Get-Command gitleaks -ErrorAction SilentlyContinue
if ($gitleaks) {
    & gitleaks protect --staged --config .gitleaks.toml --redact --no-banner
    if ($LASTEXITCODE -ne 0) {
        Write-Host '拒绝提交：gitleaks 检出疑似凭据（见上方报告）。' -ForegroundColor Red
        exit 1
    }
}

exit 0
