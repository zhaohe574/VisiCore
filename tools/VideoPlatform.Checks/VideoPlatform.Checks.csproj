<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 与所引用的 API／Adapter／Desktop 项目保持一致；此前为 net8.0-windows，导致 NU1201 无法构建。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VideoPlatform.Desktop/VideoPlatform.Desktop.csproj" />
    <ProjectReference Include="../../src/VideoPlatform.Updater/VideoPlatform.Updater.csproj" />
    <ProjectReference Include="../../src/VideoPlatform.Api/VideoPlatform.Api.csproj" />
    <ProjectReference Include="../../src/Hikvision.Adapter/Hikvision.Adapter.csproj" />
  </ItemGroup>
</Project>
