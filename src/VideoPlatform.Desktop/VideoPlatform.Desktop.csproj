<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <Product>VisiCore（视枢）</Product>
    <AssemblyTitle>VisiCore 视枢值守端</AssemblyTitle>
    <Description>VisiCore（视枢）视频值守桌面客户端</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VideoPlatform.Client/VideoPlatform.Client.csproj" />
    <Resource Include="Assets/Brand.png" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
</Project>
