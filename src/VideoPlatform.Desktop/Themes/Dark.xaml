<!--
  VisiCore 桌面端深色主题令牌（与 Themes/Light.xaml 键集完全一致）。
  运行时由 ThemeService 替换 App 资源中的主题字典即可整体换肤。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 表面：页面 - 侧栏 - 卡片 - 浮层 -->
    <SolidColorBrush x:Key="PageBrush" Color="#1E2124"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#26292E"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#202327"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#26292E"/>
    <SolidColorBrush x:Key="InputBrush" Color="#1A1C20"/>
    <SolidColorBrush x:Key="InputDisabledBrush" Color="#212429"/>
    <SolidColorBrush x:Key="FlyoutBrush" Color="#212429"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#181A1D"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderMutedBrush" Color="#9EA5B0"/>
    <SolidColorBrush x:Key="HeaderHoverBrush" Color="#22252A"/>
    <SolidColorBrush x:Key="HeaderPressBrush" Color="#364457"/>
    <SolidColorBrush x:Key="HeaderDividerBrush" Color="#282C33"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2F343C"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#25282F"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#2B2F36"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#ECEDEF"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9EA5B0"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#636A75"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <!-- 深色主题的强调橙较亮，白字对比度只有 2.33；橙色按钮上的文字改用深色（7.77:1） -->
    <SolidColorBrush x:Key="OnAccentEmphasisBrush" Color="#12161D"/>

    <!-- 边框与分隔 -->
    <SolidColorBrush x:Key="LineBrush" Color="#363B43"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#404650"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2B2F36"/>

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3F49"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#555C6B"/>

    <!-- 树/列表系统选中色需要 Color 值（SolidColorBrush 的 Color 属性不支持动态引用） -->
    <Color x:Key="SelectionBrushColor">#2B2F36</Color>
    <Color x:Key="TextBrushColor">#ECEDEF</Color>

    <!-- 强调与状态：深色主题下填充色本身就是高对比亮色，*TextBrush 与填充色取同值即可 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8C00"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA033"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2C18"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFA033"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1E6FEB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3A82F0"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1B2740"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#6CB0FF"/>
    <SolidColorBrush x:Key="OnlineBrush" Color="#43B581"/>
    <SolidColorBrush x:Key="OnlineTextBrush" Color="#56C795"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FAA61A"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FAA61A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E81123"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C4101E"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="OfflineBrush" Color="#747F8D"/>
    <SolidColorBrush x:Key="OfflineTextBrush" Color="#9EA5B0"/>
    <SolidColorBrush x:Key="HikvisionOrangeBrush" Color="#FF8C00"/>
    <SolidColorBrush x:Key="HikvisionBlueBrush" Color="#0091FF"/>

    <!-- 按钮 -->
    <SolidColorBrush x:Key="ButtonBrush" Color="#32363E"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#404650"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#424752"/>
    <SolidColorBrush x:Key="ButtonPressBrush" Color="#25282F"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#2A2E36"/>

    <!-- 视频画面区 -->
    <SolidColorBrush x:Key="VideoCanvasBrush" Color="#101114"/>
    <SolidColorBrush x:Key="VideoCellBrush" Color="#121417"/>
    <SolidColorBrush x:Key="VideoChromeBrush" Color="#101216"/>
    <SolidColorBrush x:Key="VideoOverlayBrush" Color="#E6101418"/>
    <SolidColorBrush x:Key="VideoOverlaySolidBrush" Color="#181A1D"/>
    <SolidColorBrush x:Key="VideoOverlayLineBrush" Color="#353A44"/>
    <SolidColorBrush x:Key="VideoOverlayTextBrush" Color="#ECEDEF"/>
    <SolidColorBrush x:Key="VideoOverlayMutedBrush" Color="#9EA5B0"/>
    <SolidColorBrush x:Key="VideoPlaceholderIconBrush" Color="#2A2E35"/>
    <SolidColorBrush x:Key="VideoBadgeBrush" Color="#B4303339"/>
    <SolidColorBrush x:Key="VideoBadgeTextBrush" Color="#FFFFFF"/>

    <sys:Double x:Key="TitleBarHeight">44</sys:Double>
    <sys:Double x:Key="NavRailWidth">58</sys:Double>
    <sys:Double x:Key="StatusBarHeight">28</sys:Double>
</ResourceDictionary>


