<UserControl x:Class="VideoPlatform.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VideoPlatform.Desktop.Views"
             xmlns:vm="clr-namespace:VideoPlatform.Desktop.ViewModels"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <!-- 通用控制栏内容模板（供普通模式停靠栏与全屏模式悬浮栏共用） -->
        <ControlTemplate x:Key="BottomToolbarContentTemplate">
            <DockPanel VerticalAlignment="Center">
                <!-- 左侧：播放与抓图控制组 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="&#xE71A;" Style="{StaticResource IconButton}" ToolTip="停止选中窗口" Command="{Binding StopSelectedCommand}" Margin="0,0,2,0"/>
                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="停止全部窗口" Command="{Binding StopAllCommand}" Margin="0,0,6,0"/>
                    <Separator Width="1" Height="16" Margin="0,0,6,0"/>
                    <Button Content="&#xE722;" Style="{StaticResource IconButton}" ToolTip="快速抓图 (Ctrl+S)" Command="{Binding QuickCaptureCommand}" CommandParameter="{Binding SelectedTile}" Margin="0,0,2,0"/>
                    <Button Content="&#xE748;" Style="{StaticResource IconButton}" ToolTip="全部窗口抓图" Command="{Binding QuickCaptureAllCommand}" Margin="0,0,6,0"/>
                    <Separator Width="1" Height="16" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="切换声音" Command="{Binding ToggleMuteCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE767;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTile.IsMuted}" Value="False">
                                            <Setter Property="Text" Value="&#xE995;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <!-- 右侧：分屏档位与全屏 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="分屏" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
                    <ItemsControl ItemsSource="{Binding LayoutPresets}" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="LayoutPreset" Style="{StaticResource LayoutPresetButton}"
                                             Command="{Binding DataContext.SetLayoutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding Key}"
                                             Content="{Binding Label}"
                                             ToolTip="{Binding Key}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource MultiReferenceEquals}" Mode="OneWay">
                                            <Binding Path="DataContext.SelectedLayoutPreset" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Width="1" Height="16" Margin="0,0,8,0"/>
                    <Button Content="&#xE740;" Style="{StaticResource IconButton}" ToolTip="单窗放大 / 还原 (双击画面)" Command="{Binding ToggleMaximizeCommand}" Margin="0,0,2,0"/>
                    <Button Command="{Binding FullscreenCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="ToolTip" Value="全屏显示 (F11)"/>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock Text="&#xE92D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                        <Setter Property="ToolTip" Value="退出全屏 (Esc / F11)"/>
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- 中间：当前选中窗口状态胶囊 -->
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="12,3" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectedTile.Title, StringFormat='当前焦点：{0}'}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                </Border>
            </DockPanel>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="0">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="272"/>
                        <Setter Property="MinWidth" Value="240"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Width" Value="0"/>
                                <Setter Property="MinWidth" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：iVMS-4200 风格设备资源面板 -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 面板标题：功能名 + 在线统计 -->
                <DockPanel Grid.Row="0" Margin="12,10,12,6">
                    <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource OnlineBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OnlineStatsLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnlineTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderText}">
                                <Setter Property="Text" Value="组织机构"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayback}" Value="True">
                                        <Setter Property="Text" Value="录像检索"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <Border Grid.Row="0" Style="{StaticResource HeaderDivider}" VerticalAlignment="Bottom"/>

                <!-- 远程回放左侧检索面板（日历、时间段、检索与录像段列表） -->
                <StackPanel Grid.Row="1" Margin="12,8,12,8" Visibility="{Binding IsPlayback, Converter={StaticResource BoolVisibility}}">
                    <Calendar x:Name="RecordingCalendar" SelectedDate="{Binding RecordingDate}" AutomationProperties.Name="录像日期"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="开始时间" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding StartTime}" Width="70" HorizontalAlignment="Right" AutomationProperties.Name="开始时间"/>
                    </DockPanel>
                    <TextBlock Text="* 结束时间自动覆盖至当天 23:59:59" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SearchRecordingsCommand}" IsEnabled="{Binding CanPlayback}" Margin="0,8,0,0" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="检索录像" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource PanelCard}" Margin="0,10,0,0" Padding="8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="录像段" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding Recordings.Count, StringFormat=共 {0} 段}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" MaxHeight="140">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Command="{Binding PlayRecordingCommand}" IsEnabled="{Binding CanPlayback}" Height="26" Padding="10,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="播放" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportRecordingCommand}" IsEnabled="{Binding CanExport}" Height="26" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="导出" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="双击左侧通道直接检索；回放前请先选择通道。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,6,0,0"/>
                </StackPanel>

                <!-- 搜索过滤条 -->
                <Grid Grid.Row="2" Margin="12,0,12,6" Visibility="{Binding IsPlayback, Converter={StaticResource InverseVisibility}}">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="26,5,24,5" AutomationProperties.Name="搜索视频资源"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="8" Command="{Binding ClearSearchCommand}" ToolTip="清空搜索" HorizontalAlignment="Right" Margin="0,0,3,0"/>
                </Grid>

                <!-- 工具行：刷新、展开折叠、收藏筛选 -->
                <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="6,3" Margin="12,0,12,6" CornerRadius="3"
                        Visibility="{Binding IsPlayback, Converter={StaticResource InverseVisibility}}">
                    <DockPanel LastChildFill="False">
                        <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="11" ToolTip="刷新资源列表" Command="{Binding RefreshResourcesCommand}" Margin="0,0,2,0"/>
                        <Button Content="&#xE740;" Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="11" ToolTip="展开所有节点" Command="{Binding ExpandAllResourcesCommand}" Margin="0,0,2,0"/>
                        <Button Content="&#xE73F;" Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="11" ToolTip="折叠所有节点" Command="{Binding CollapseAllResourcesCommand}" Margin="0,0,6,0"/>
                        <CheckBox Content="仅收藏" IsChecked="{Binding FavoritesOnly}" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="11"/>
                        <Button Content="&#xE734;" Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="11" ToolTip="收藏/取消收藏当前选中通道" Command="{Binding ToggleFavoriteCommand}" DockPanel.Dock="Right"/>
                    </DockPanel>
                </Border>

                <!-- 核心树形结构控件（组织架构：车间 → 区域 → 单元 → 通道；右键菜单提供预览/回放/云台/导出/收藏） -->
                <TreeView x:Name="ResourceTree" Grid.Row="4" ItemsSource="{Binding Resources}"
                          SelectedItemChanged="ResourceSelected" MouseDoubleClick="ResourceDoubleClicked"
                          PreviewMouseLeftButtonDown="DragStarted" PreviewMouseMove="DragMoved"
                          Padding="4,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVisibility}}"/>
                            <Setter Property="Padding" Value="1,2"/>
                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:ResourceNode}" ItemsSource="{Binding Children}">
                            <DockPanel Margin="0,2" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChannel}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnlineBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding OnlineCountLabel}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding SecondaryLabel}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChannel}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChannel}" Value="True"/>
                                                        <Condition Binding="{Binding IsOnline}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="{DynamicResource OfflineTextBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="" Margin="0"/>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="实时预览" Click="TreePreviewClicked"/>
                            <MenuItem Header="远程回放" Click="TreePlaybackClicked"/>
                            <Separator/>
                            <MenuItem Header="批量预览选中通道" Click="TreeBatchPreviewClicked"/>
                            <MenuItem Header="云台控制" Click="TreePtzClicked"/>
                            <MenuItem Header="录像导出" Click="TreeExportClicked"/>
                            <Separator/>
                            <MenuItem Header="加入 / 移出收藏" Command="{Binding ToggleFavoriteCommand}"/>
                            <MenuItem Header="刷新资源" Command="{Binding RefreshResourcesCommand}"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>

                <!-- 底部方案设置抽屉（折叠式，仅主预览） -->
                <Expander Grid.Row="5" Header="方案设置" Foreground="{DynamicResource MutedBrush}" Margin="8,4" Padding="4" IsExpanded="False"
                          Visibility="{Binding IsPlayback, Converter={StaticResource InverseVisibility}}">
                    <StackPanel Margin="0,6,0,0">
                        <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" DisplayMemberPath="Label" Margin="0,0,0,6"/>
                        <TextBlock Text="方案名称" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LayoutName}" AutomationProperties.Name="方案名称" Margin="0,0,0,6"/>
                        <CheckBox Content="设为巡视轮巡" IsChecked="{Binding SaveAsPatrol}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="轮巡停留秒数" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding IntervalSeconds}" Width="60" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <CheckBox Content="共享到平台" IsChecked="{Binding ShareLayout}" IsEnabled="{Binding CanShareLayouts}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="应用" Command="{Binding ApplyLayoutCommand}" Margin="0,0,4,0"/>
                            <Button Content="删除" Command="{Binding DeleteLayoutCommand}" Margin="0,0,4,0"/>
                            <Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="刷新方案列表" Command="{Binding RefreshResourcesCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="另存方案" Command="{Binding SaveLayoutCommand}" Margin="0,0,4,0"/>
                            <Button Content="更新方案" Command="{Binding UpdateLayoutCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <!-- 分割条 -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <!-- 中右侧主工作区 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: 视图标签栏（iVMS-4200 实时预览工具条） -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlayback}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Command="{Binding TogglePatrolCommand}" Height="26" Padding="10,0" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPatrolling}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPatrolling}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="开始轮巡"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPatrolling}" Value="True">
                                                    <Setter Property="Text" Value="停止轮巡"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NewViewCommand}" Height="26" Padding="10,0" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="新建视图" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveViewCommand}" Height="26" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="保存视图" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="视图" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ListBox x:Name="ViewTabs" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                             PreviewMouseLeftButtonUp="ViewTabClicked" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="B" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="12,4">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="patrol">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="（点击视图切换分屏方案）" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Row 1: 视频监控矩阵与云台控制抽屉 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 中央视频网格（VideoWallPanel 按档位格位排布，档位切换不重建播放器） -->
                <Border Grid.Column="0" Background="Black">
                    <Grid x:Name="VideoMatrixHost" ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding Tiles}" Margin="0" Padding="0">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolVisibility}}"/>
                                    <Setter Property="Grid.Row" Value="{Binding GridRow}"/>
                                    <Setter Property="Grid.Column" Value="{Binding GridColumn}"/>
                                    <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:VideoWallPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:VideoTileView/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 空白处点击：取消选中高亮（替代原先每次点击向上遍历视觉树的判定） -->
                        <Border Background="Transparent" Panel.ZIndex="-1" MouseLeftButtonDown="MatrixBlankClicked"/>
                    </Grid>
                </Border>

                <!-- 云台折叠开关细条 -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,1,0" Width="14" VerticalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlayback}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Style="{StaticResource IconButton}" Width="14" Height="28" Padding="0" Cursor="Hand" Command="{Binding TogglePtzCollapsedCommand}" ToolTip="展开 / 收起云台面板">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE76C;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPtzCollapsed}" Value="True">
                                            <Setter Property="Text" Value="&#xE76B;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Border>

                <!-- 右侧云台控制面板（iVMS-4200 经典圆形罗盘） -->
                <Border Grid.Column="2" Width="228" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlayback}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPtzCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,10" IsEnabled="{Binding CanPtz}">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="云台控制" Style="{StaticResource PanelHeaderText}"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedTile.Channel.DisplayName, FallbackValue='未选通道'}" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DockPanel>
                            <Border Style="{StaticResource HeaderDivider}" Margin="0,0,0,10"/>

                            <!-- 方向：圆形八向罗盘 -->
                            <Border Width="146" Height="146" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="2" CornerRadius="73" Margin="0,2,0,12" HorizontalAlignment="Center">
                                <Grid>
                                    <Button Content="&#xE70E;" Style="{StaticResource IconButton}" Width="32" Height="30" FontSize="13" ToolTip="向上倾斜" Tag="up"
                                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
                                            PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/>
                                    <Button Content="&#xE70D;" Style="{StaticResource IconButton}" Width="32" Height="30" FontSize="13" ToolTip="向下倾斜" Tag="down"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"
                                            PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/>
                                    <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Width="30" Height="32" FontSize="13" ToolTip="向左旋转" Tag="left"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                                            PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/>
                                    <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Width="30" Height="32" FontSize="13" ToolTip="向右旋转" Tag="right"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
                                            PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/>
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Width="44" Height="44" Tag="auto" ToolTip="自动扫描 / 停止" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="自动" FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 速度 -->
                            <Border Style="{StaticResource PanelCard}" Padding="8,6" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="云台速度" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="{Binding PtzSpeed, StringFormat='步长 {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Slider Minimum="1" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PtzSpeed}"/>
                                </StackPanel>
                            </Border>

                            <!-- 镜控：变倍 / 聚焦 / 光圈 -->
                            <Border Style="{StaticResource PanelCard}" Padding="8,6" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="变倍" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button ToolTip="拉近焦距" Tag="zoomIn" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased" Height="24" Padding="6,0" FontSize="10" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="放大" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="拉远焦距" Tag="zoomOut" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased" Height="24" Padding="6,0" FontSize="10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="缩小" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="聚焦" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button ToolTip="聚焦远" Tag="focusFar" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased" Height="24" Padding="6,0" FontSize="10" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="远焦" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="聚焦近" Tag="focusNear" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased" Height="24" Padding="6,0" FontSize="10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="近焦" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="光圈" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button ToolTip="开大光圈" Tag="irisOpen" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased" Height="24" Padding="6,0" FontSize="10" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="开大" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button ToolTip="缩小光圈" Tag="irisClose" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased" Height="24" Padding="6,0" FontSize="10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="缩小" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 预置点 -->
                            <Border Style="{StaticResource PanelCard}" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="预置点管理" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                    <DockPanel>
                                        <Button Content="调用" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Command="{Binding CallPresetCommand}" Height="26" Padding="12,0" Margin="6,0,0,0"/>
                                        <TextBox Text="{Binding Preset}" Height="26" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Row 2: 视频墙底部标准控制栏（全屏模式折叠为 0） -->
            <Border Grid.Row="2" x:Name="BottomToolbar" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Height" Value="0"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ContentControl Template="{StaticResource BottomToolbarContentTemplate}"/>
            </Border>

            <!-- Row 3: 录像回放时间轴与播放控制（仅回放模式显示） -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="12,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Visibility="{Binding IsPlayback, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <views:RecordingTimeline x:Name="Timeline"
                                             Start="{Binding RangeStart}" End="{Binding RangeEnd}"
                                             Position="{Binding Playhead}"
                                             Segments="{Binding TimelineSegments}"
                                             Tracks="{Binding TimelineTracks}"
                                             SelectedRangeStart="{Binding TimelineClipStart, Mode=TwoWay}"
                                             SelectedRangeEnd="{Binding TimelineClipEnd, Mode=TwoWay}"
                                             Margin="0,0,0,6"
                                             AutomationProperties.Name="录像时间轴"/>
                    <!-- 回放控制条居中排布（iVMS-4200 回放控制条语义） -->
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <CheckBox Content="统一控制" IsChecked="{Binding UnifiedControl}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="今天" Style="{StaticResource ToolbarButton}" Command="{Binding ApplyQuickPresetCommand}" CommandParameter="today" Height="24" Padding="6,0" Margin="0,0,4,0" ToolTip="检索今天全天"/>
                            <Button Content="昨天" Style="{StaticResource ToolbarButton}" Command="{Binding ApplyQuickPresetCommand}" CommandParameter="yesterday" Height="24" Padding="6,0" Margin="0,0,4,0" ToolTip="检索昨天全天"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="&#xE72B;" Style="{StaticResource IconButton}" ToolTip="快退 10 秒" Command="{Binding StepBackwardCommand}"/>
                            <Button Content="&#xE769;" Style="{StaticResource IconButton}" ToolTip="暂停回放" Command="{Binding PlaybackActionCommand}" CommandParameter="pause"/>
                            <Button Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="继续回放" Command="{Binding PlaybackActionCommand}" CommandParameter="resume"/>
                            <Button Content="&#xE72A;" Style="{StaticResource IconButton}" ToolTip="快进 10 秒" Command="{Binding StepForwardCommand}"/>
                            <Button Content="&#xE8B1;" Style="{StaticResource IconButton}" ToolTip="单帧步进（暂停下一帧）" Command="{Binding FrameStepCommand}" Margin="4,0,0,0"/>
                            <ComboBox ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding PlaybackSpeed}" Width="66" Margin="10,0,4,0"/>
                            <TextBlock Text="倍速" Margin="2,0,4,0" VerticalAlignment="Center"/>
                            <Button Content="&#xE8FB;" Style="{StaticResource IconButton}" ToolTip="应用回放倍速" Command="{Binding ApplySpeedCommand}"/>
                            <TextBlock Text="{Binding Playhead, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Margin="14,0" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Command="{Binding ExportTimelineClipCommand}" IsEnabled="{Binding CanExport}" Height="26" Padding="10,0" ToolTip="导出时间轴所选区间或当前录像">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="{Binding ExportButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 抓图 Toast 通知卡片（无软阴影，避免中间表面合成开销） -->
        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,48"
                Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolVisibility}}" MaxWidth="400" Panel.ZIndex="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource OnlineBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToastMessage}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="查看图片" Padding="8,3" FontSize="11" Command="{Binding OpenToastFileCommand}"/>
                        <Button Content="打开文件夹" Padding="8,3" FontSize="11" Margin="6,0,0,0" Command="{Binding OpenToastFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="9" VerticalAlignment="Top" Margin="8,-6,-6,0" Command="{Binding DismissToastCommand}" ToolTip="关闭"/>
            </Grid>
        </Border>

        <!-- 全屏模式底部浮动控制条：独立顶层 Popup 浮动于视频表面上方，杜绝空域遮挡；移开或闲置自动隐藏 -->
        <Popup x:Name="FullscreenBottomPopup"
               AllowsTransparency="True"
               Focusable="False"
               PlacementTarget="{Binding ElementName=VideoMatrixHost}"
               Placement="Custom"
               PopupAnimation="Fade">
            <Border x:Name="FullscreenBottomBar"
                    Background="{DynamicResource VideoOverlaySolidBrush}"
                    BorderBrush="{DynamicResource VideoOverlayLineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,4"
                    Height="40"
                    SnapsToDevicePixels="True">
                <ContentControl Template="{StaticResource BottomToolbarContentTemplate}"/>
            </Border>
        </Popup>

        <!-- 全屏模式右上角退出提示条：独立顶层 Popup 浮动于视频右上角 -->
        <Popup x:Name="FullscreenExitPopup"
               AllowsTransparency="True"
               Focusable="False"
               PlacementTarget="{Binding ElementName=VideoMatrixHost}"
               Placement="Custom"
               PopupAnimation="Fade">
            <Border x:Name="FullscreenExitBar"
                    Background="{DynamicResource VideoOverlaySolidBrush}"
                    BorderBrush="{DynamicResource VideoOverlayLineBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,4"
                    SnapsToDevicePixels="True">
                <Button Style="{StaticResource IconButton}" Command="{Binding FullscreenCommand}" ToolTip="退出全屏 (Esc / F11)" Height="28" Padding="8,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="退出全屏 (Esc)" FontSize="12" Foreground="{DynamicResource VideoOverlayTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
        </Popup>
    </Grid>
</UserControl>





