<UserControl x:Class="VideoPlatform.Desktop.Views.WorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:VideoPlatform.Desktop.Views" xmlns:vm="clr-namespace:VideoPlatform.Desktop.ViewModels" Foreground="{StaticResource TextBrush}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="252" MinWidth="210"/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource PanelBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="12,10"><DockPanel><TextBlock Text="视频资源" FontWeight="SemiBold"/><Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="刷新资源" Command="{Binding RefreshResourcesCommand}" HorizontalAlignment="Right"/></DockPanel><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索视频资源" Margin="0,8"/><DockPanel><CheckBox Content="仅收藏" IsChecked="{Binding FavoritesOnly}"/><Button Content="&#xE734;" Style="{StaticResource IconButton}" ToolTip="收藏或取消收藏选中通道" Command="{Binding ToggleFavoriteCommand}" HorizontalAlignment="Right"/></DockPanel></StackPanel>
            <TreeView x:Name="ResourceTree" Grid.Row="1" ItemsSource="{Binding Resources}" SelectedItemChanged="ResourceSelected" MouseDoubleClick="ResourceDoubleClicked" PreviewMouseLeftButtonDown="DragStarted" PreviewMouseMove="DragMoved"><TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type vm:ResourceNode}" ItemsSource="{Binding Children}"><CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" ToolTip="{Binding Channel.Detail}"/></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView>
            <Expander Grid.Row="2" Header="布局与轮巡" Foreground="{StaticResource TextBrush}" Margin="10" IsExpanded="False"><StackPanel Margin="0,8,0,0">
                <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" DisplayMemberPath="Label"/><StackPanel Orientation="Horizontal" Margin="0,6"><Button Content="应用" Command="{Binding ApplyLayoutCommand}"/><Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="删除方案" Command="{Binding DeleteLayoutCommand}"/><Button Content="&#xE71A;" Style="{StaticResource IconButton}" ToolTip="停止轮巡" Command="{Binding StopPatrolCommand}" IsEnabled="{Binding IsPatrolling}"/></StackPanel>
                <TextBox Text="{Binding LayoutName}" AutomationProperties.Name="布局名称"/><CheckBox Content="保存为轮巡" IsChecked="{Binding SaveAsPatrol}" Margin="0,8"/><DockPanel><TextBlock Text="停留秒数"/><TextBox Text="{Binding IntervalSeconds}" Width="70" HorizontalAlignment="Right"/></DockPanel><CheckBox Content="共享方案" IsChecked="{Binding ShareLayout}" IsEnabled="{Binding CanShareLayouts}" Margin="0,8"/><StackPanel Orientation="Horizontal"><Button Content="另存方案" Command="{Binding SaveLayoutCommand}"/><Button Content="更新方案" Command="{Binding UpdateLayoutCommand}"/></StackPanel>
            </StackPanel></Expander>
        </Grid></Border>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#17191C"/>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="26"/></Grid.RowDefinitions>
            <Border Background="#303338" Padding="8,5"><WrapPanel VerticalAlignment="Center">
                <Button Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="播放所选通道" Command="{Binding StartSelectedCommand}"/><Button Content="&#xE71A;" Style="{StaticResource IconButton}" ToolTip="停止选中窗口" Command="{Binding StopSelectedCommand}"/><Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="停止全部窗口" Command="{Binding StopAllCommand}"/>
                <Separator Width="12"/><Button Content="1" ToolTip="单窗口" Command="{Binding SetLayoutCommand}" CommandParameter="1" Width="34"/><Button Content="4" ToolTip="四分屏" Command="{Binding SetLayoutCommand}" CommandParameter="4" Width="34"/><Button Content="9" ToolTip="九分屏" Command="{Binding SetLayoutCommand}" CommandParameter="9" Width="34"/><Button Content="16" ToolTip="十六分屏" Command="{Binding SetLayoutCommand}" CommandParameter="16" Width="38"/>
                <Separator Width="12"/><Button Content="&#xE722;" Style="{StaticResource IconButton}" ToolTip="截图" Command="{Binding CaptureCommand}"/><Button Style="{StaticResource IconButton}" ToolTip="切换声音" Command="{Binding ToggleMuteCommand}"><TextBlock FontFamily="Segoe MDL2 Assets"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE767;"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTile.IsMuted}" Value="False"><Setter Property="Text" Value="&#xE995;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button><Button Content="&#xE740;" Style="{StaticResource IconButton}" ToolTip="放大或还原选中窗口" Command="{Binding ToggleMaximizeCommand}"/><Button Content="&#xE92D;" Style="{StaticResource IconButton}" ToolTip="全屏" Command="{Binding FullscreenCommand}"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlayback, Converter={StaticResource InverseVisibility}}"><ComboBox ItemsSource="{Binding StreamOptions}" SelectedValue="{Binding StreamType}" DisplayMemberPath="Label" SelectedValuePath="Value" Width="90" Margin="12,0,2,0"/><Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="切换所选窗口码流" Command="{Binding ApplyStreamCommand}"/></StackPanel>
            </WrapPanel></Border>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Tiles}" Margin="4"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVisibility}}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding GridColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><views:VideoTileView/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Border Grid.Column="1" Width="184" Background="{StaticResource PanelBrush}" Visibility="{Binding IsPlayback, Converter={StaticResource InverseVisibility}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" IsEnabled="{Binding CanPtz}">
                    <TextBlock Text="云台控制" FontWeight="SemiBold" Margin="0,0,0,12"/><UniformGrid Rows="3" Columns="3"><Border/><Button Content="&#xE70E;" Style="{StaticResource IconButton}" ToolTip="上" Tag="up" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/><Border/><Button Content="&#xE76B;" Style="{StaticResource IconButton}" ToolTip="左" Tag="left" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/><Button Content="&#xE71A;" Style="{StaticResource IconButton}" ToolTip="停止" Command="{Binding StopPtzCommandCommand}"/><Button Content="&#xE76C;" Style="{StaticResource IconButton}" ToolTip="右" Tag="right" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/><Border/><Button Content="&#xE70D;" Style="{StaticResource IconButton}" ToolTip="下" Tag="down" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/><Border/></UniformGrid>
                    <Button Content="自动扫描" Tag="auto" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased" Margin="0,8"/><TextBlock Text="速度"/><Slider Minimum="1" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PtzSpeed}" Margin="0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions><TextBlock Text="变倍"/><Button Grid.Column="1" Content="&#xE8A3;" Style="{StaticResource IconButton}" ToolTip="拉近" Tag="zoomIn" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/><Button Grid.Column="2" Content="&#xE71F;" Style="{StaticResource IconButton}" ToolTip="拉远" Tag="zoomOut" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/>
                    <TextBlock Grid.Row="1" Text="聚焦"/><Button Grid.Row="1" Grid.Column="1" Content="&#xE710;" Style="{StaticResource IconButton}" ToolTip="近焦" Tag="focusNear" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/><Button Grid.Row="1" Grid.Column="2" Content="&#xE738;" Style="{StaticResource IconButton}" ToolTip="远焦" Tag="focusFar" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/>
                    <TextBlock Grid.Row="2" Text="光圈"/><Button Grid.Row="2" Grid.Column="1" Content="&#xE710;" Style="{StaticResource IconButton}" ToolTip="开光圈" Tag="irisOpen" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/><Button Grid.Row="2" Grid.Column="2" Content="&#xE738;" Style="{StaticResource IconButton}" ToolTip="关光圈" Tag="irisClose" PreviewMouseLeftButtonDown="PtzPressed" LostMouseCapture="PtzReleased"/></Grid>
                    <TextBlock Text="预置位" Margin="0,14,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="调用" Command="{Binding CallPresetCommand}"/><TextBox Text="{Binding Preset}"/></DockPanel>
                </StackPanel></ScrollViewer></Border>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="12,8" Visibility="{Binding IsPlayback, Converter={StaticResource BoolVisibility}}"><StackPanel>
                <WrapPanel><DatePicker SelectedDate="{Binding RecordingDate}" Width="126"/><TextBox Text="{Binding StartTime}" Width="88" Margin="6,0" AutomationProperties.Name="开始时间"/><TextBlock Text="至"/><TextBox Text="{Binding EndTime}" Width="88" Margin="6,0" AutomationProperties.Name="结束时间"/><Button Content="检索" Command="{Binding SearchRecordingsCommand}" IsEnabled="{Binding CanPlayback}"/><ComboBox ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" DisplayMemberPath="Label" Width="200" Margin="6,0"/><Button Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="播放选中录像" Command="{Binding PlayRecordingCommand}"/><Button Content="导出" Command="{Binding CreateExportCommand}" IsEnabled="{Binding CanExport}"/></WrapPanel>
                <views:RecordingTimeline x:Name="Timeline" Start="{Binding RangeStart}" End="{Binding RangeEnd}" Position="{Binding Playhead}" Segments="{Binding TimelineSegments}" Margin="0,8,0,4" AutomationProperties.Name="录像时间轴"/>
                <WrapPanel><CheckBox Content="统一控制" IsChecked="{Binding UnifiedControl}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="&#xE769;" Style="{StaticResource IconButton}" ToolTip="暂停回放" Command="{Binding PlaybackActionCommand}" CommandParameter="pause"/><Button Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="继续回放" Command="{Binding PlaybackActionCommand}" CommandParameter="resume"/><ComboBox ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding PlaybackSpeed}" Width="66" Margin="12,0,2,0"/><TextBlock Text="倍速"/><Button Content="&#xE8FB;" Style="{StaticResource IconButton}" ToolTip="应用回放倍速" Command="{Binding ApplySpeedCommand}"/><TextBlock Text="{Binding Playhead, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Margin="18,0" Foreground="#F1B46C"/></WrapPanel>
            </StackPanel></Border>
            <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
    </Grid>
</UserControl>
