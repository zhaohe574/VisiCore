<UserControl x:Class="VideoPlatform.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}">
    <ScrollViewer Background="{StaticResource PageBrush}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="640" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,24">
                <Button DockPanel.Dock="Left" Content="{Binding BackButtonText}" Command="{Binding CloseSettingsCommand}" VerticalAlignment="Center" Margin="0,0,16,0" Padding="14,6"/>
                <TextBlock Text="设置与更新" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="平台连接" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Server}" Margin="0,12" TextWrapping="Wrap"/><CheckBox Content="RTSP 局域网兼容模式" IsChecked="{Binding PreferRtsp}" Margin="0,4,0,24"/>
            <TextBlock Text="客户端版本" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionLabel}" Margin="0,10"/><TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,10,0,24"><Button Content="检查更新" Command="{Binding CheckUpdateCommand}"/><Button Content="安装更新" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding UpdateAvailable}" Margin="8,0,0,0"/></StackPanel>
        <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}"><TextBlock Text="个人资料" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="姓名" Margin="0,14,0,8"/><TextBox Text="{Binding DisplayName}" Width="360" HorizontalAlignment="Left"/><TextBlock Text="手机号码" Margin="0,14,0,8"/><TextBox Text="{Binding Phone}" Width="360" HorizontalAlignment="Left"/><Button Content="保存资料" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Left" Margin="0,12,0,24"/>
            <TextBlock Text="修改密码" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="当前密码" Margin="0,14,0,8"/><PasswordBox x:Name="CurrentPassword" Width="360" HorizontalAlignment="Left"/><TextBlock Text="新密码" Margin="0,14,0,8"/><PasswordBox x:Name="NewPassword" Width="360" HorizontalAlignment="Left"/><Button Content="修改密码" Click="ChangePasswordClicked" HorizontalAlignment="Left" Margin="0,12"/>
        </StackPanel>
    </StackPanel></ScrollViewer>
</UserControl>
