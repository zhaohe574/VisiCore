<UserControl x:Class="VideoPlatform.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid Background="{DynamicResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏（海康威视 iVMS-4200 风格设置顶栏：返回按钮 + 系统设置标题 + 版本徽章） -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="{Binding BackButtonText}" Command="{Binding CloseSettingsCommand}" Padding="14,6" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" Background="{DynamicResource HoverBrush}" CornerRadius="3" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="系统设置" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"/>
                    <TextBlock Text="界面外观、图像解码、存储目录与平台参数" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主体结构：左侧分类导航 + 右侧卡片式参数面板 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧分类导航竖栏 -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="8,12">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style x:Key="SettingsNavBtn" TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Height" Value="46"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <Button Command="{Binding SetSettingsTabCommand}" CommandParameter="general">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsTab}" Value="general">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True">
                            <Border Width="3" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Margin="-10,8,10,8"
                                    Visibility="{Binding SettingsTab, Converter={StaticResource MatchVisibility}, ConverterParameter=general}"/>
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="常规与外观" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </DockPanel>
                    </Button>

                    <Button Command="{Binding SetSettingsTabCommand}" CommandParameter="media">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsTab}" Value="media">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True">
                            <Border Width="3" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Margin="-10,8,10,8"
                                    Visibility="{Binding SettingsTab, Converter={StaticResource MatchVisibility}, ConverterParameter=media}"/>
                            <TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="图像与解码" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </DockPanel>
                    </Button>

                    <Button Command="{Binding SetSettingsTabCommand}" CommandParameter="storage">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsTab}" Value="storage">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True">
                            <Border Width="3" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Margin="-10,8,10,8"
                                    Visibility="{Binding SettingsTab, Converter={StaticResource MatchVisibility}, ConverterParameter=storage}"/>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="存储与目录" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </DockPanel>
                    </Button>

                    <Button Command="{Binding SetSettingsTabCommand}" CommandParameter="about">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsNavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsTab}" Value="about">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True">
                            <Border Width="3" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Margin="-10,8,10,8"
                                    Visibility="{Binding SettingsTab, Converter={StaticResource MatchVisibility}, ConverterParameter=about}"/>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="系统与关于" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 右侧详情参数面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                    <!-- ================= TAB 1: 常规与外观 ================= -->
                    <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource MatchVisibility}, ConverterParameter=general}">
                        <TextBlock Text="界面外观" Style="{StaticResource PanelHeaderText}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="主题配色" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="支持经典海康 iVMS 浅色主题与夜间低眩光深色主题" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton GroupName="Theme" Content="浅色（默认）" Margin="0,0,16,0"
                                                     IsChecked="{Binding Theme, Converter={StaticResource Match}, ConverterParameter=light, Mode=OneWay}"
                                                     Command="{Binding SetThemeCommand}" CommandParameter="light"/>
                                        <RadioButton GroupName="Theme" Content="深色"
                                                     IsChecked="{Binding Theme, Converter={StaticResource Match}, ConverterParameter=dark, Mode=OneWay}"
                                                     Command="{Binding SetThemeCommand}" CommandParameter="dark"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="显示状态" Style="{StaticResource PanelHeaderText}" Margin="0,10,0,8"/>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <CheckBox Content="在底端状态栏显示性能诊断（媒体会话数与解码器数）" IsChecked="{Binding ShowDiagnostics}" Margin="0,0,0,4"/>
                                <TextBlock Text="开启后可在底端状态栏实时核对当前激活会话、Direct3D11 硬件解码器占用与推进秒数。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= TAB 2: 图像与解码 ================= -->
                    <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource MatchVisibility}, ConverterParameter=media}">
                        <TextBlock Text="视频解码与呈现" Style="{StaticResource PanelHeaderText}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="启用 GPU 硬件加速解码（Direct3D 11）" IsChecked="{Binding HardwareDecoding}" Margin="0,0,0,4"/>
                                <TextBlock Text="利用显卡 NVDEC / Intel QSV 硬件直通呈现 1080P/4K 码流，大幅降低 CPU 负载。显卡不支持或硬解配额用尽时自动平滑降级至单线程软解。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Border Style="{StaticResource HeaderDivider}" Margin="0,0,0,14"/>

                                <CheckBox Content="多分屏网格优先使用子码流（推荐）" IsChecked="{Binding PreferSubStreamInGrid}" Margin="0,0,0,4"/>
                                <TextBlock Text="在 1/4/9/16 路网格排布下默认拉取子码流，单窗双击放大或全屏时自动升为主码流；关闭后全部分屏均强制使用主码流，会成倍增加显存与解码占用。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="网络与传输策略" Style="{StaticResource PanelHeaderText}" Margin="0,10,0,8"/>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="网络防抖缓冲时间" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="3" Padding="8,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding NetworkCachingMs, StringFormat='{}{0} ms'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11"/>
                                    </Border>
                                </DockPanel>
                                <Slider Minimum="200" Maximum="5000" TickFrequency="200" IsSnapToTickEnabled="True" Value="{Binding NetworkCachingMs}" Margin="0,0,0,4"/>
                                <TextBlock Text="缓冲时长越大越能抵抗网络偶发抖动与丢包，但首帧起流延迟增加；局域网建议 200–800 ms，广域网推荐 1000–2000 ms。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Border Style="{StaticResource HeaderDivider}" Margin="0,0,0,14"/>

                                <CheckBox Content="RTSP 局域网直连兼容模式" IsChecked="{Binding PreferRtsp}" Margin="0,0,0,4"/>
                                <TextBlock Text="默认优先使用 HTTPS MPEG-TS 直通低延迟传输（回退 HTTPS FLV）；当处于纯内网或特殊交换网络时可启用 RTSP 兼容直连。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= TAB 3: 存储与目录 ================= -->
                    <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource MatchVisibility}, ConverterParameter=storage}">
                        <TextBlock Text="本地抓图" Style="{StaticResource PanelHeaderText}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="抓图保存目录" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="浏览..." Command="{Binding BrowseSnapshotPathCommand}" Padding="14,5" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding SnapshotPath, Mode=TwoWay}" IsReadOnly="True" Padding="8,5" Background="{DynamicResource InputDisabledBrush}"/>
                                </DockPanel>

                                <TextBlock Text="抓图图片格式" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="SnapshotFormat" Content="PNG（无损高保真）" Margin="0,0,16,0"
                                                 IsChecked="{Binding SnapshotFormat, Converter={StaticResource Match}, ConverterParameter=PNG}"/>
                                    <RadioButton GroupName="SnapshotFormat" Content="JPEG（节省磁盘空间）"
                                                 IsChecked="{Binding SnapshotFormat, Converter={StaticResource Match}, ConverterParameter=JPEG}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="录像导出" Style="{StaticResource PanelHeaderText}" Margin="0,10,0,8"/>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="录像下载保存目录" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="浏览..." Command="{Binding BrowseExportPathCommand}" Padding="14,5" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding ExportPath, Mode=TwoWay}" IsReadOnly="True" Padding="8,5" Background="{DynamicResource InputDisabledBrush}"/>
                                </DockPanel>
                                <TextBlock Text="从远程回放或任务中心导出的录像分段将下载至该目录，下载前请确保目标磁盘拥有足够可用空间。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= TAB 4: 系统与关于 ================= -->
                    <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource MatchVisibility}, ConverterParameter=about}">
                        <TextBlock Text="平台连接" Style="{StaticResource PanelHeaderText}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="平台地址" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Server}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="连接状态" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource OnlineBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ConnectionState}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="版本与更新" Style="{StaticResource PanelHeaderText}" Margin="0,10,0,8"/>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="客户端版本" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding VersionLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="运行环境" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text=".NET 10.0 · Direct3D 11 · LibVLC Native" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </DockPanel>
                                <Border Style="{StaticResource HeaderDivider}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" Margin="0,0,8,0" Padding="14,5"/>
                                    <Button Content="安装更新" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding UpdateAvailable}" Padding="16,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
