<UserControl x:Class="VideoPlatform.Desktop.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid Background="{DynamicResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 面板标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="刷新报警列表" Command="{Binding RefreshAsyncCommand}" Margin="0,0,6,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="报警中心" Style="{StaticResource PanelHeaderText}"/>
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Total, StringFormat='共 {0} 条'}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 过滤工具行 -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <WrapPanel>
                <TextBlock Text="状态" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding States}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding State}" Width="104"/>
                <TextBlock Text="事件" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Text="{Binding EventType}" Width="120" ToolTip="事件类型" AutomationProperties.Name="事件类型"/>
                <TextBlock Text="关键字" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Text="{Binding Search}" Width="170" AutomationProperties.Name="搜索报警"/>
                <TextBlock Text="发生时间" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <DatePicker SelectedDate="{Binding From}" Width="122"/>
                <TextBlock Text="至" Margin="6,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                <DatePicker SelectedDate="{Binding To}" Width="122"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SearchAlarmsCommand}" IsEnabled="{Binding CanRead}" Margin="12,0,0,0" Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="查询" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- 列表 + 详情 -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="0,0,12,0" MouseDoubleClick="AlarmDoubleClicked">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="发生时间" Binding="{Binding OccurredAt, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="140"/>
                    <DataGridTextColumn Header="通道" Binding="{Binding ChannelName}" Width="*"/>
                    <DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="120"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="80"/>
                    <DataGridTextColumn Header="处理人" Binding="{Binding OwnerName}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="报警详情" Style="{StaticResource PanelHeaderText}"/>
                            <TextBlock Text="{Binding Selected.StateLabel}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Border Style="{StaticResource HeaderDivider}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Selected.DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.ChannelName}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding Selected.RecoveryLabel}" Foreground="{DynamicResource OnlineTextBrush}" Margin="0,6,0,0"/>
                        <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="220" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanRead}">
                            <Button Command="{Binding VideoCommand}" CommandParameter="live" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="实况预览" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding VideoCommand}" CommandParameter="playback">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="录像回放" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding Selected.Note}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="处理备注" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,6"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="76" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="处理备注"/>
                        <WrapPanel IsEnabled="{Binding CanHandle}" Margin="0,10,0,0">
                            <Button Content="认领" Command="{Binding HandleCommand}" CommandParameter="claim" Margin="0,0,6,0"/>
                            <Button Content="保存备注" Command="{Binding HandleCommand}" CommandParameter="note" Margin="0,0,6,0"/>
                            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Command="{Binding HandleCommand}" CommandParameter="close" Margin="0,0,6,0"/>
                            <Button Content="重新打开" Command="{Binding HandleCommand}" CommandParameter="reopen"/>
                        </WrapPanel>
                        <TextBlock Text="处理记录" Style="{StaticResource PanelHeaderText}" Margin="0,18,0,6"/>
                        <Border Style="{StaticResource HeaderDivider}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <DockPanel>
                                            <TextBlock Text="{Binding ActionLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Username}" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm:ss}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 分页与状态 -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding PageNumber, StringFormat='第 {0} 页'}" Margin="8,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    <Button Content="&#xE76B;" Style="{StaticResource IconButton}" ToolTip="上一页" Command="{Binding PreviousPageCommand}"/>
                    <Button Content="&#xE76C;" Style="{StaticResource IconButton}" ToolTip="下一页" Command="{Binding NextPageCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedBrush}" ToolTip="{Binding Status}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>


