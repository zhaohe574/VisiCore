<UserControl x:Class="VideoPlatform.Desktop.Views.AlarmsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="报警中心" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><WrapPanel Margin="0,0,0,14"><ComboBox ItemsSource="{Binding States}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding State}" Width="110"/><TextBox Text="{Binding Search}" Width="180" Margin="8,0" AutomationProperties.Name="搜索报警"/><TextBox Text="{Binding EventType}" Width="130" ToolTip="事件类型"/><DatePicker SelectedDate="{Binding From}" Width="130" Margin="8,0"/><TextBlock Text="至"/><DatePicker SelectedDate="{Binding To}" Width="130" Margin="8,0"/><Button Content="查询" Command="{Binding SearchAlarmsCommand}" IsEnabled="{Binding CanRead}"/></WrapPanel></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="0,0,16,0" MouseDoubleClick="AlarmDoubleClicked"><DataGrid.Columns><DataGridTextColumn Header="发生时间" Binding="{Binding OccurredAt, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="140"/><DataGridTextColumn Header="通道" Binding="{Binding ChannelName}" Width="*"/><DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="80"/><DataGridTextColumn Header="处理人" Binding="{Binding OwnerName}" Width="90"/></DataGrid.Columns></DataGrid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="报警详情" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="{Binding Selected.DeviceName}" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.ChannelName}" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.RecoveryLabel}" Foreground="#82C9B2"/><Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="220" Margin="0,12"/><WrapPanel Margin="0,10,0,0" IsEnabled="{Binding CanRead}"><Button Content="&#xE714; 实况预览" Command="{Binding VideoCommand}" CommandParameter="live"/><Button Content="&#xE768; 录像回放" Command="{Binding VideoCommand}" CommandParameter="playback" Margin="6,0,0,0"/></WrapPanel><TextBlock Text="{Binding Selected.Note}" TextWrapping="Wrap"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="处理备注" Margin="0,10"/><WrapPanel IsEnabled="{Binding CanHandle}"><Button Content="认领" Command="{Binding HandleCommand}" CommandParameter="claim"/><Button Content="保存备注" Command="{Binding HandleCommand}" CommandParameter="note"/><Button Content="关闭" Command="{Binding HandleCommand}" CommandParameter="close"/><Button Content="重新打开" Command="{Binding HandleCommand}" CommandParameter="reopen"/></WrapPanel><TextBlock Text="处理记录" FontWeight="SemiBold" Margin="0,20,0,8"/><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><DockPanel><TextBlock Text="{Binding ActionLabel}"/><TextBlock Text="{Binding Username}" Margin="12,0"/></DockPanel><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm:ss}}" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="2"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="{Binding Total, StringFormat=共 {0} 条}" Margin="8,0"/><Button Content="&#xE76B;" Style="{StaticResource IconButton}" ToolTip="上一页" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageNumber}" Margin="8,0"/><Button Content="&#xE76C;" Style="{StaticResource IconButton}" ToolTip="下一页" Command="{Binding NextPageCommand}"/></StackPanel><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Grid>
</UserControl>
