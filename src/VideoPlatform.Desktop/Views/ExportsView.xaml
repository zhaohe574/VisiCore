<UserControl x:Class="VideoPlatform.Desktop.Views.ExportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <TextBlock Text="录像导出" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14"><Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="刷新任务" Command="{Binding RefreshJobsCommand}"/><Button Content="取消任务" Command="{Binding CancelJobCommand}"/><Button Content="重试" Command="{Binding RetryCommand}"/><Button Content="&#xE896;" Style="{StaticResource IconButton}" ToolTip="下载已完成录像" Command="{Binding DownloadCommand}"/></StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"><DataGrid.Columns><DataGridTextColumn Header="通道" Binding="{Binding ChannelName}" Width="*"/><DataGridTextColumn Header="开始时间" Binding="{Binding Start, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="145"/><DataGridTextColumn Header="结束时间" Binding="{Binding End, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="145"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="85"/><DataGridTextColumn Header="进度" Binding="{Binding Progress, StringFormat={}{0:0}%}" Width="70"/><DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="到期时间" Binding="{Binding ExpiresAt, StringFormat={}{0:MM-dd HH:mm}}" Width="120"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="3" Margin="0,10"><TextBlock Text="{Binding Selected.Error}" Foreground="#F1B46C" TextWrapping="Wrap"/><DockPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}"><Button Content="取消下载" DockPanel.Dock="Right" Command="{Binding CancelDownloadCommand}"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="10" VerticalAlignment="Center" Foreground="#419D84"/></DockPanel></StackPanel>
        <DockPanel Grid.Row="4"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="{Binding Total, StringFormat=共 {0} 条}" Margin="8,0"/><Button Content="&#xE76B;" Style="{StaticResource IconButton}" ToolTip="上一页" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageNumber}" Margin="8,0"/><Button Content="&#xE76C;" Style="{StaticResource IconButton}" ToolTip="下一页" Command="{Binding NextPageCommand}"/></StackPanel><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></DockPanel>
    </Grid>
</UserControl>
