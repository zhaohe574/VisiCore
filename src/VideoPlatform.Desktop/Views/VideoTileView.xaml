<UserControl x:Class="VideoPlatform.Desktop.Views.VideoTileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource TextBrush}" AllowDrop="True" Drop="Dropped" PreviewMouseLeftButtonDown="Selected">
    <Border BorderThickness="2" Margin="2"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#363A40"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid Background="#141618"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
            <Grid><TextBlock Text="{Binding Number}" FontSize="26" Foreground="#50565E" HorizontalAlignment="Center"/>
                <ContentControl x:Name="PlayerHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
            <DockPanel Grid.Row="1" Background="#2A2D31"><TextBlock Text="{Binding StateLabel}" DockPanel.Dock="Right" Margin="8,0" FontSize="10" Foreground="{StaticResource MutedBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateLabel}"/><TextBlock Text="{Binding Title}" FontSize="11" Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DockPanel>
        </Grid>
    </Border>
</UserControl>
