<UserControl x:Class="VideoPlatform.Desktop.Views.VideoTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VideoPlatform.Desktop.Views"
             x:Name="RootTile"
             Background="Black"
             Margin="0"
             Padding="0"
             AllowDrop="True"
             Drop="Dropped"
             PreviewMouseLeftButtonDown="TileMouseLeftDown"
             PreviewMouseRightButtonDown="TileMouseRightDown"
             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}">
    <UserControl.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="停止预览" Command="{Binding StopTileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="切换码流">
                <MenuItem Header="主码流 (高清)" Click="SwitchToMainStreamClicked"/>
                <MenuItem Header="子码流 (流畅)" Click="SwitchToSubStreamClicked"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="一键抓图" Command="{Binding QuickCaptureCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+S"/>
            <MenuItem Header="抓图另存为..." Command="{Binding SaveCaptureAsCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="静音 / 声音" Command="{Binding ToggleMuteTileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="画面比例">
                <MenuItem Header="自适应铺满" Click="AspectRatioClicked" Tag="fill"/>
                <MenuItem Header="原始比例" Click="AspectRatioClicked" Tag="original"/>
                <MenuItem Header="16 : 9" Click="AspectRatioClicked" Tag="16:9"/>
                <MenuItem Header="4 : 3" Click="AspectRatioClicked" Tag="4:3"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="单窗放大 / 还原" Command="{Binding ToggleMaximizeCommand}"/>
            <MenuItem Command="{Binding FullscreenCommand}" InputGestureText="F11">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="全屏显示"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Header" Value="退出全屏 (Esc)"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator/>
            <MenuItem Header="停止全部预览" Command="{Binding StopAllCommand}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Grid Background="Black">
        <!-- 原生播放器宿主（100% 占满全窗格，无缝自适应铺满） -->
        <ContentControl x:Name="PlayerHost" Background="Black"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Margin="0" Padding="0"/>

        <!-- 空窗格占位：iVMS-4200 语义（窗口编号 + 通道名 + 拖入/双击提示） -->
        <Grid Visibility="{Binding IsPlaying, Converter={StaticResource InverseVisibility}}" IsHitTestVisible="False" Background="{DynamicResource VideoCellBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220">
                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource VideoPlaceholderIconBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VideoOverlayTextBrush}"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding StateLabel}" FontSize="11" Foreground="{DynamicResource VideoOverlayMutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="从左侧拖入通道 · 双击开始预览" FontSize="10" Foreground="{DynamicResource VideoPlaceholderIconBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 浮动操作条：通过独立顶层 Popup 浮动于视频画面上方，移入显示，移出或闲置 2.5s 自动隐藏 -->
        <Popup x:Name="TileHeaderPopup"
               AllowsTransparency="True"
               Focusable="False"
               Placement="Relative"
               HorizontalOffset="0"
               VerticalOffset="0"
               PopupAnimation="Fade">
            <Border x:Name="TileHeaderBar"
                    Background="{DynamicResource VideoOverlaySolidBrush}"
                    MouseRightButtonUp="OnHeaderRightButtonUp"
                    Padding="6,3,6,3"
                    Height="26"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：在线状态绿点 + 通道标题（DockPanel 严格约束宽度，超长文本自动省略号，杜绝挤占右侧按钮） -->
                    <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource VideoOverlayMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource OnlineBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding HeaderTitle}" ToolTip="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource VideoOverlayTextBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- 右侧：码流角标 + 窗口编号 + 快捷控制（始终完整呈现） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 码流角标 -->
                        <Border Background="{DynamicResource VideoBadgeBrush}" CornerRadius="2" Padding="4,1" Margin="0,0,4,0"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding StreamBadge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource VideoBadgeTextBrush}"/>
                        </Border>

                        <!-- 窗口编号 -->
                        <Border Background="{DynamicResource VideoOverlayBrush}" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                            <TextBlock Text="{Binding Number}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource VideoOverlayMutedBrush}"/>
                        </Border>

                        <!-- 快捷操作按钮组 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 快速声音切换 -->
                            <Button Style="{DynamicResource IconButton}" Width="20" Height="20" Padding="0" Margin="1,0"
                                    Click="OnHeaderMuteClicked"
                                    ToolTip="静音 / 声音"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolVisibility}}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource VideoOverlayTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE74F;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="False">
                                                    <Setter Property="Text" Value="&#xE767;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnlineBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- 一键抓图 -->
                            <Button Style="{DynamicResource IconButton}" Width="20" Height="20" Padding="0" Margin="1,0"
                                    Click="OnHeaderCaptureClicked"
                                    ToolTip="一键抓图 (Ctrl+S)"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource VideoOverlayTextBrush}"/>
                            </Button>

                            <!-- 单窗放大/还原 -->
                            <Button Width="20" Height="20" Padding="0" Margin="1,0"
                                    Click="OnHeaderMaximizeClicked">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="ToolTip" Value="单窗放大 (双击画面)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                <Setter Property="ToolTip" Value="向下还原 (双击画面)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource VideoOverlayTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE740;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73F;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- 停止播放 -->
                            <Button Style="{DynamicResource IconButton}" Width="20" Height="20" Padding="0" Margin="1,0"
                                    Click="OnHeaderStopClicked"
                                    ToolTip="停止播放"
                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource VideoOverlayTextBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- 选中焦点高亮边框（未选中无边框零缝隙） -->
        <Border IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
