<Window x:Class="VideoPlatform.Desktop.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改密码" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" Padding="16,0,8,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="修改密码" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource WindowCloseButton}" Click="CloseClicked" ToolTip="关闭" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- 内容表单 -->
        <Border Grid.Row="1" Padding="24,20" Background="{DynamicResource SurfaceBrush}">
            <StackPanel>
                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,16">
                    <TextBlock Text="密码修改成功后将自动登出，需使用新密码重新登录。" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="当前密码" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="CurrentPasswordBox" Padding="10,6" Margin="0,0,0,14"/>

                <TextBlock Text="新密码" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="NewPasswordBox" Padding="10,6" Margin="0,0,0,14"/>

                <TextBlock Text="确认新密码" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,6" Margin="0,0,0,14"/>

                <TextBlock x:Name="ErrorMessage" Text="" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 底部控制按钮 -->
        <Border Grid.Row="2" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel LastChildFill="False">
                <Button Content="取消" Click="CancelClicked" IsCancel="True" Padding="16,6" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <Button Content="确认修改" Style="{StaticResource PrimaryButton}" Click="SubmitClicked" IsDefault="True" Padding="20,6" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
