<Window x:Class="VideoPlatform.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VideoPlatform.Desktop.Views"
        Title="VisiCore（视枢）- 工业视频综合管理系统"
        Width="1440" Height="900" MinWidth="640" MinHeight="340"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Loaded="LoadedWindow" Closing="ClosingWindow" Deactivated="DeactivatedWindow"
        PreviewMouseLeftButtonUp="ReleasedPointer" PreviewKeyDown="KeyPressed">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <ScrollViewer x:Name="ShellViewport">
        <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Workspace.IsFullscreen}" Value="True">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Style>
        <!-- 约束工作区按视口有限测量；小窗口仍通过最小逻辑尺寸保留滚动访问 -->
        <Grid Width="{Binding ViewportWidth, ElementName=ShellViewport}" Height="{Binding ViewportHeight, ElementName=ShellViewport}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="MinWidth" Value="1000"/>
                    <Setter Property="MinHeight" Value="650"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Workspace.IsFullscreen}" Value="True">
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="Auto"/>
                <RowDefinition x:Name="NavBarRow" Height="0"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="StatusBarRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: 顶部品牌、导航与窗口控制一体化标题栏（消除冗余原生白边标题栏，海康威视 iVMS-4200 风格） -->
            <Border x:Name="TopTitleBar" Grid.Row="0" Height="42" Background="#16181B" BorderBrush="#282C33" BorderThickness="0,0,0,1" Padding="14,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Workspace.IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="False">
                    <!-- 左侧：Logo、品牌名以及未登录时的系统标识 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Image Source="Assets/Brand.png" Width="22" Height="22" Margin="0,0,8,0"/>
                        <TextBlock Text="VisiCore · 视枢" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#242830" CornerRadius="2" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseVisibility}}">
                            <TextBlock Text="工业视频综合管理系统" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- 中间：已登录时的模块导航选项卡（主预览、远程回放、报警中心、导出任务） -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="24,0,0,0"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton GroupName="Module" Style="{StaticResource TabButton}" Height="42"
                                     IsChecked="{Binding Module, Converter={StaticResource Match}, ConverterParameter=live, Mode=OneWay}"
                                     Command="{Binding SwitchModuleCommand}" CommandParameter="live">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="主预览" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Module" Style="{StaticResource TabButton}" Height="42"
                                     IsChecked="{Binding Module, Converter={StaticResource Match}, ConverterParameter=playback, Mode=OneWay}"
                                     Command="{Binding SwitchModuleCommand}" CommandParameter="playback">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="远程回放" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Module" Style="{StaticResource TabButton}" Height="42"
                                     IsChecked="{Binding Module, Converter={StaticResource Match}, ConverterParameter=alarms, Mode=OneWay}"
                                     Command="{Binding SwitchModuleCommand}" CommandParameter="alarms">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="报警中心" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Module" Style="{StaticResource TabButton}" Height="42"
                                     IsChecked="{Binding Module, Converter={StaticResource Match}, ConverterParameter=exports, Mode=OneWay}"
                                     Command="{Binding SwitchModuleCommand}" CommandParameter="exports">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="导出任务" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 最右侧：窗口控制按钮组（最小化、最大化/向下还原、关闭） -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE921;" ToolTip="最小化"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;" ToolTip="最大化"/>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" ToolTip="关闭"/>
                    </StackPanel>

                    <!-- 右侧操作区：状态指示、设置齿轮按钮与用户中心下拉 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Background="#1E2228" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource OnlineBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectionState}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="&#xE713;" Style="{StaticResource IconButton}" ToolTip="设置与更新"
                                Command="{Binding SwitchModuleCommand}" CommandParameter="settings" Margin="0,0,4,0"/>
                        <Button x:Name="UserMenuButton" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}"
                                Background="Transparent" BorderThickness="0" Padding="6,3" ToolTip="用户中心">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#242832" CornerRadius="10" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding UserLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="{StaticResource MutedBrush}" Margin="5,0,0,0"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="个人资料" Command="{Binding SwitchModuleCommand}" CommandParameter="settings"/>
                                    <MenuItem Header="修改密码" Command="{Binding SwitchModuleCommand}" CommandParameter="settings"/>
                                    <MenuItem Header="检查更新" Command="{Binding CheckUpdateCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="退出登录" Command="{Binding LogoutCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 1: 保留 0 高度行以保持 Grid 行索引与布局测试严格兼容 -->
            <Border Grid.Row="1" Height="0" Visibility="Collapsed"/>

            <!-- Row 2: 中间主视图容器 -->
            <Grid Grid.Row="2">
                <Grid Visibility="{Binding CanUseWorkspace, Converter={StaticResource BoolVisibility}}">
                    <views:WorkspaceView DataContext="{Binding Workspace}" Visibility="{Binding DataContext.Module, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleVisibility}, ConverterParameter=media}"/>
                    <views:AlarmsView DataContext="{Binding Alarms}" Visibility="{Binding DataContext.Module, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleVisibility}, ConverterParameter=alarms}"/>
                    <views:ExportsView DataContext="{Binding Exports}" Visibility="{Binding DataContext.Module, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleVisibility}, ConverterParameter=exports}"/>
                </Grid>
                <views:LoginView Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseVisibility}}"/>
                <views:SettingsView Visibility="{Binding Module, Converter={StaticResource ModuleVisibility}, ConverterParameter=settings}"/>
                <Border Background="{StaticResource PageBrush}" Visibility="{Binding UpdateRequired, Converter={StaticResource BoolVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                        <TextBlock Text="客户端需要更新" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,16" Foreground="{StaticResource MutedBrush}"/>
                        <Button Content="安装更新" Command="{Binding InstallUpdateCommand}"/>
                        <Button Content="重新检查" Command="{Binding CheckUpdateCommand}" Margin="0,8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: 底部状态条 (DockPanel) -->
            <DockPanel Grid.Row="3" Height="26" Background="#16181B" LastChildFill="True">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Workspace.IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <TextBlock Text="{Binding Clock}" DockPanel.Dock="Right" Margin="14,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding VersionLabel}" DockPanel.Dock="Right" Margin="14,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding ConnectionState}" DockPanel.Dock="Right" Margin="12,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding Status}" Margin="14,0" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
