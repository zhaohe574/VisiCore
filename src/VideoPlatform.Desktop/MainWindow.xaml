<Window x:Class="VideoPlatform.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:VideoPlatform.Desktop.Views"
        Title="VisiCore（视枢）" Width="1440" Height="900" MinWidth="640" MinHeight="340" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Loaded="LoadedWindow" Closing="ClosingWindow" Deactivated="DeactivatedWindow" PreviewMouseLeftButtonUp="ReleasedPointer" PreviewKeyDown="KeyPressed">
    <ScrollViewer x:Name="ShellViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <!-- 约束工作区按视口有限测量；小窗口仍通过最小逻辑尺寸保留滚动访问。 -->
        <Grid MinWidth="1000" MinHeight="650" Width="{Binding ViewportWidth, ElementName=ShellViewport}" Height="{Binding ViewportHeight, ElementName=ShellViewport}">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Background="#17191C" Padding="18,0"><DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Image Source="Assets/Brand.png" Width="30" Height="30" Margin="0,0,12,0"/><TextBlock Text="VisiCore · 视枢" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="值守工作台" Margin="18,0,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding UserLabel}" Margin="12,0"/><Button Content="&#xE8AC;" Style="{StaticResource IconButton}" ToolTip="退出登录" Command="{Binding LogoutCommand}" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}"/></StackPanel>
        </DockPanel></Border>
        <DockPanel Grid.Row="1" Background="#282B2F"><StackPanel Orientation="Horizontal" IsEnabled="{Binding IsAuthenticated}">
            <RadioButton Content="实时预览" GroupName="Module" Style="{StaticResource TabButton}" IsChecked="{Binding Module, Converter={StaticResource Match}, ConverterParameter=live, Mode=OneWay}" Command="{Binding SwitchModuleCommand}" CommandParameter="live"/>
            <RadioButton Content="录像回放" GroupName="Module" Style="{StaticResource TabButton}" IsChecked="{Binding Module, Converter={StaticResource Match}, ConverterParameter=playback, Mode=OneWay}" Command="{Binding SwitchModuleCommand}" CommandParameter="playback"/>
            <RadioButton Content="报警中心" GroupName="Module" Style="{StaticResource TabButton}" IsChecked="{Binding Module, Converter={StaticResource Match}, ConverterParameter=alarms, Mode=OneWay}" Command="{Binding SwitchModuleCommand}" CommandParameter="alarms"/>
            <RadioButton Content="导出任务" GroupName="Module" Style="{StaticResource TabButton}" IsChecked="{Binding Module, Converter={StaticResource Match}, ConverterParameter=exports, Mode=OneWay}" Command="{Binding SwitchModuleCommand}" CommandParameter="exports"/>
        </StackPanel><Button Content="&#xE713;" Style="{StaticResource IconButton}" ToolTip="设置与更新" HorizontalAlignment="Right" Command="{Binding SwitchModuleCommand}" CommandParameter="settings"/></DockPanel>
        <Grid Grid.Row="2">
            <Grid Visibility="{Binding CanUseWorkspace, Converter={StaticResource BoolVisibility}}">
                <views:WorkspaceView DataContext="{Binding Workspace}" Visibility="{Binding DataContext.Module, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleVisibility}, ConverterParameter=media}"/>
                <views:AlarmsView DataContext="{Binding Alarms}" Visibility="{Binding DataContext.Module, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleVisibility}, ConverterParameter=alarms}"/>
                <views:ExportsView DataContext="{Binding Exports}" Visibility="{Binding DataContext.Module, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModuleVisibility}, ConverterParameter=exports}"/>
            </Grid>
            <views:LoginView Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseVisibility}}"/>
            <views:SettingsView Visibility="{Binding Module, Converter={StaticResource ModuleVisibility}, ConverterParameter=settings}"/>
            <Border Background="{StaticResource PageBrush}" Visibility="{Binding UpdateRequired, Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400"><TextBlock Text="客户端需要更新" FontSize="24"/><TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,16"/><Button Content="安装更新" Command="{Binding InstallUpdateCommand}"/><Button Content="重新检查" Command="{Binding CheckUpdateCommand}" Margin="0,8"/></StackPanel></Border>
        </Grid>
        <DockPanel Grid.Row="3" Background="#17191C"><TextBlock Text="{Binding VersionLabel}" DockPanel.Dock="Right" Margin="12,0" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ConnectionState}" DockPanel.Dock="Right" Margin="12,0" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Status}" Margin="16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></DockPanel>
    </Grid></ScrollViewer>
</Window>
