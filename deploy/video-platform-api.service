[Unit]
Description=视频平台 API 服务
Wants=network-online.target
After=network-online.target hikvision-adapter.service

[Service]
Type=simple
User=liteware
Group=liteware
WorkingDirectory=/opt/video-platform
EnvironmentFile=/home/liteware/.config/video-platform/platform-api.env
ExecStartPre=/usr/bin/test -x /opt/video-platform/VideoPlatform.Api
ExecStart=/opt/video-platform/VideoPlatform.Api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/video-platform/releases /var/lib/video-platform/device-online-trend.json

[Install]
WantedBy=multi-user.target
