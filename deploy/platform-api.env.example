# VisiCore（视枢）平台 API / Worker 环境变量示例
#
# 本文件仅作字段说明，**不含任何真实口令**。
# 生产环境请勿手工照抄：正式部署以 deploy/v2-install.py 生成为准，
# 它会写入 /home/liteware/.config/video-platform/v2.env 并设置 0600 权限。
#
# 变量名与默认值必须与代码保持一致，权威来源：
#   src/VideoPlatform.Infrastructure/PlatformOptions.cs
#   deploy/v2-install.py

# ── 必填 ────────────────────────────────────────────────────────────────
# PostgreSQL 连接串。生产库名为 video_platform_v2（不是第一版的 video_platform）。
PLATFORM_DATABASE_URL=Host=127.0.0.1;Database=video_platform_v2;Username=video_platform_v2;Password=<数据库口令>;Maximum Pool Size=64

# 适配器内部通信密钥，必须为足够长的随机串。
HIK_ADAPTER_INTERNAL_KEY=<随机密钥>

# 初始管理员口令。仅在库中没有任何 admin 账号时用于创建首个管理员；
# 必须满足平台口令策略（至少 12 个字符）。
PLATFORM_ADMIN_PASSWORD=<初始管理员口令>

# ── 服务监听与地址 ──────────────────────────────────────────────────────
# API 监听地址。默认 5082；Nginx 反代到该端口。
PLATFORM_API_URL=http://127.0.0.1:5082

# 对外访问地址，必须是无凭据的 https 站点地址；用于生成媒体链接与证书默认域名。
PLATFORM_PUBLIC_URL=https://<生产机地址>

# 对外 RTSP 推流地址。
PLATFORM_RTSP_URL=rtsp://<生产机地址>:18555

# ── 数据目录 ────────────────────────────────────────────────────────────
# 数据根目录，其下派生 releases/、exports/、keys/、plugins/、ssl/。
# Linux 默认 /var/lib/video-platform/v2；Windows 默认 %LOCALAPPDATA%\VideoPlatform\server-v2。
PLATFORM_DATA_PATH=/var/lib/video-platform/v2

# SSL 证书目录（video-platform.crt / video-platform.key）。
# Linux 默认 /etc/nginx/ssl。
PLATFORM_SSL_PATH=/etc/nginx/ssl

# ── 依赖服务 ────────────────────────────────────────────────────────────
# 录像机适配器内部控制端口（海康 5092，中维 5093）。
HIK_ADAPTER_API_URL=http://127.0.0.1:5092

# ZLMediaKit HTTP API 与管理密钥。
ZLM_API_URL=http://127.0.0.1:18082
ZLM_API_SECRET=<ZLM 管理密钥>

# ── 可选 ────────────────────────────────────────────────────────────────
# 初始管理员账号名，默认 admin。
PLATFORM_ADMIN_USER=admin

# 受信任的自签名证书 SHA-256 指纹白名单（分号或逗号分隔）。
#
# 默认情况下平台使用操作系统信任链校验 TLS 证书，这是推荐做法：
# 把内部 CA 证书导入系统信任库即可，见 tools/install-platform-certificate.ps1。
#
# 仅当无法导入系统信任库（例如网管设备使用自签名证书）时，才在此显式登记该证书指纹。
# 未登记的证书一律拒绝——不要再使用"跳过证书校验"的做法。
# 获取指纹：openssl x509 -in cert.crt -noout -fingerprint -sha256
# PLATFORM_TRUSTED_CERT_SHA256=

# ── 后台任务调优（可选，均有安全范围校验） ──────────────────────────────
# WORKER_DEVICE_CONCURRENCY=4          # 1..32
# WORKER_MAINTENANCE_CONCURRENCY=4     # 1..16
# WORKER_EXPORT_TIMEOUT_MINUTES=360    # 1..2880
