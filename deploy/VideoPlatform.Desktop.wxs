<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef PublishDir ?><?define PublishDir="$(sys.SOURCEFILEDIR)..\artifacts\desktop-win-x64" ?><?endif ?>
  <?ifndef PackageVersion ?><?define PackageVersion="2.0.0" ?><?endif ?>
  <?ifndef PackageName ?><?define PackageName="VisiCore（视枢）" ?><?endif ?>
  <?ifndef PackageUpgradeCode ?><?define PackageUpgradeCode="8D1D5A6B-5E3C-4CF8-9D5E-9A7B1E5B7A11" ?><?endif ?>
  <?ifndef PackageScope ?><?define PackageScope="perMachine" ?><?endif ?>
  <?ifndef PackageRoot ?><?define PackageRoot="ProgramFiles6432Folder" ?><?endif ?>
  <?ifndef RegistryRoot ?><?define RegistryRoot="HKLM" ?><?endif ?>
  <?ifndef RegistryKey ?><?define RegistryKey="Software\Liteware\VideoPlatform.Desktop" ?><?endif ?>
  <?ifndef InstallFolderName ?><?define InstallFolderName="VideoPlatform.Desktop" ?><?endif ?>
  <Package Name="$(var.PackageName)" Manufacturer="Liteware" Version="$(var.PackageVersion)" UpgradeCode="$(var.PackageUpgradeCode)" Scope="$(var.PackageScope)" Language="2052" Codepage="65001">
    <SummaryInformation Description="VisiCore（视枢）桌面客户端安装程序" />
    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="已安装更高版本的 VisiCore（视枢）。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\src\VideoPlatform.Desktop\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="both" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="SAVEDINSTALLDIR">
      <RegistrySearch Id="PreviousInstallDirectory" Root="$(var.RegistryRoot)" Key="$(var.RegistryKey)" Name="InstallDir" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[SAVEDINSTALLDIR]" Before="CostFinalize" Sequence="both" Condition="SAVEDINSTALLDIR AND NOT INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)..\src\VideoPlatform.Desktop\Assets\InstallerBanner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)..\src\VideoPlatform.Desktop\Assets\InstallerDialog.bmp" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="1" />
    </UI>
    <Feature Id="MainFeature" Title="VisiCore（视枢）" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="InstallDirectoryRegistry" />
    </Feature>
    <?ifdef InjectFailure ?>
    <CustomAction Id="ControlledUpgradeFailure" Directory="SystemFolder" ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c exit 1603" Execute="deferred" Return="check" Impersonate="yes" />
    <InstallExecuteSequence><Custom Action="ControlledUpgradeFailure" After="InstallFiles" Condition="NOT Installed" /></InstallExecuteSequence>
    <?endif ?>
  </Package>

  <Fragment>
    <StandardDirectory Id="$(var.PackageRoot)">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolderName)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="ProductMenuFolder" Name="$(var.PackageName)" /></StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Component Id="DesktopExecutableComponent" Guid="*">
        <File Id="DesktopExecutable" Source="$(var.PublishDir)\VideoPlatform.Desktop.exe" KeyPath="yes" />
      </Component>
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\VideoPlatform.Desktop.exe" />
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ProductMenuFolder" Guid="*">
      <Shortcut Id="StartMenuLink" Name="$(var.PackageName)" Target="[INSTALLFOLDER]VideoPlatform.Desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <Shortcut Id="UninstallLink" Name="卸载$(var.PackageName)" Target="[SystemFolder]msiexec.exe" Arguments="/x [ProductCode]" Icon="AppIcon" />
      <RemoveFolder Id="RemoveProductMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="$(var.RegistryKey)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopLink" Name="$(var.PackageName)" Target="[INSTALLFOLDER]VideoPlatform.Desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="$(var.RegistryKey)" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="InstallDirectoryRegistry" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="$(var.RegistryRoot)" Key="$(var.RegistryKey)" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      <RegistryValue Root="$(var.RegistryRoot)" Key="$(var.RegistryKey)" Name="Version" Value="[ProductVersion]" Type="string" />
    </Component>
  </Fragment>
</Wix>
